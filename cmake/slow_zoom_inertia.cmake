# Add one cancellation entry point inside the pinned upstream translation unit.
# The original west checkout remains untouched; fail closed on source changes.
set(zoom_inertia_source
  "${ZEPHYR_ZMK_INPUT_PROCESSOR_SCROLL_INERTIA_MODULE_DIR}/src/input_processor_scroll_inertia.c")
file(SHA256 "${zoom_inertia_source}" zoom_inertia_hash)
if(NOT zoom_inertia_hash STREQUAL "f0e53dcfba0cd56d355001082bc65584ebfaae86404249554440d6fe49315c22")
  message(FATAL_ERROR "CLine38 zoom inertia bridge: review the changed upstream source")
endif()
set(zoom_inertia_wrapper "${CMAKE_CURRENT_BINARY_DIR}/slow_zoom_inertia.c")
file(WRITE "${zoom_inertia_wrapper}"
  "#include \"${zoom_inertia_source}\"\n#include \"slow_zoom_inertia.inc\"\n")
set_property(GLOBAL PROPERTY CLINE38_ZOOM_INERTIA_SOURCE "${zoom_inertia_source}")
set_property(GLOBAL PROPERTY CLINE38_ZOOM_INERTIA_WRAPPER "${zoom_inertia_wrapper}")
target_include_directories(app PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
set_property(DIRECTORY "${APPLICATION_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${zoom_inertia_source}")

function(cline38_replace_zoom_inertia_source)
  get_property(original GLOBAL PROPERTY CLINE38_ZOOM_INERTIA_SOURCE)
  get_property(wrapper GLOBAL PROPERTY CLINE38_ZOOM_INERTIA_WRAPPER)
  get_target_property(sources app SOURCES)
  set(found 0)
  set(kept)
  foreach(source IN LISTS sources)
    get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${APPLICATION_SOURCE_DIR}")
    if(path STREQUAL original)
      math(EXPR found "${found} + 1")
    else()
      list(APPEND kept "${source}")
    endif()
  endforeach()
  if(NOT found EQUAL 1)
    message(FATAL_ERROR "CLine38 expected exactly one scroll inertia source")
  endif()
  set_property(TARGET app PROPERTY SOURCES "${kept}")
  target_sources(app PRIVATE "${wrapper}")
  message(STATUS "CLine38 zoom: cancel pending inertia on layer 8 entry")
endfunction()
cmake_language(DEFER DIRECTORY "${APPLICATION_SOURCE_DIR}" CALL cline38_replace_zoom_inertia_source)
