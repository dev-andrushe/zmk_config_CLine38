find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(ctrl8_output "${CMAKE_CURRENT_BINARY_DIR}/cline38-ctrl8")
set(ctrl8_args --app "${APPLICATION_SOURCE_DIR}" --output "${ctrl8_output}")
if(CONFIG_ZMK_RUNTIME_MACRO)
  list(APPEND ctrl8_args --runtime "${ZEPHYR_ZMK_FEATURE_RUNTIME_MACRO_MODULE_DIR}")
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}"
  "${CMAKE_CURRENT_SOURCE_DIR}/scripts/generate_ctrl_layer8.py" ${ctrl8_args}
  RESULT_VARIABLE ctrl8_result ERROR_VARIABLE ctrl8_error)
if(NOT ctrl8_result EQUAL 0)
  message(FATAL_ERROR "CLine38 Ctrl8 source adaptation failed: ${ctrl8_error}")
endif()
set_property(GLOBAL PROPERTY CLINE38_CTRL8_OUTPUT "${ctrl8_output}")
set_property(GLOBAL PROPERTY CLINE38_CTRL8_RUNTIME "${ZEPHYR_ZMK_FEATURE_RUNTIME_MACRO_MODULE_DIR}")
set_property(DIRECTORY "${APPLICATION_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_SOURCE_DIR}/scripts/generate_ctrl_layer8.py"
  "${APPLICATION_SOURCE_DIR}/src/event_manager.c"
  "${APPLICATION_SOURCE_DIR}/src/behavior_queue.c")

function(cline38_replace_ctrl8_sources)
  get_property(output GLOBAL PROPERTY CLINE38_CTRL8_OUTPUT)
  get_property(runtime GLOBAL PROPERTY CLINE38_CTRL8_RUNTIME)
  get_target_property(sources app SOURCES)
  set(count 0)
  set(kept)
  foreach(source IN LISTS sources)
    get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${APPLICATION_SOURCE_DIR}")
    if(path STREQUAL "${APPLICATION_SOURCE_DIR}/src/event_manager.c")
      list(APPEND kept "${output}/event_manager.c")
      math(EXPR count "${count} + 1")
    elseif(path STREQUAL "${APPLICATION_SOURCE_DIR}/src/behavior_queue.c")
      list(APPEND kept "${output}/behavior_queue.c")
      math(EXPR count "${count} + 1")
    elseif(CONFIG_ZMK_RUNTIME_MACRO AND path STREQUAL "${runtime}/src/runtime_macro.c")
      list(APPEND kept "${output}/runtime_macro.c")
      math(EXPR count "${count} + 1")
    else()
      list(APPEND kept "${source}")
    endif()
  endforeach()
  if((CONFIG_ZMK_RUNTIME_MACRO AND NOT count EQUAL 3) OR
     (NOT CONFIG_ZMK_RUNTIME_MACRO AND NOT count EQUAL 2))
    message(FATAL_ERROR "CLine38 Ctrl8: expected exactly one of each bridge source")
  endif()
  set_property(TARGET app PROPERTY SOURCES "${kept}")
  message(STATUS "CLine38 Ctrl8: serialize gesture reports; preserve event subscription order")
endfunction()
cmake_language(DEFER DIRECTORY "${APPLICATION_SOURCE_DIR}" CALL cline38_replace_ctrl8_sources)
