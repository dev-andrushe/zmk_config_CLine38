#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
    retro-tap;
};

&lt {
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
    retro-tap;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        ctrl8_hold: ctrl_layer8_hold {
            compatible = "cline38,behavior-ctrl-layer8";
            #binding-cells = <1>;
            display-name = "Ctrl + Layer 8 Hold";
        };

        ctrl8: ctrl_layer8_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Ctrl + Layer 8 (No Retro)";
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&ctrl8_hold>, <&kp>;
        };

        // レイヤー1用。通常の&ltと&mtのRetro Tap設定には影響しない。
        lt1: layer_tap_1_no_retro {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Layer-Tap 1 (No Retro)";
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
            // retro-tapを付けない: 時間経過だけでホールドを有効にする。
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W     &kp E     &kp R                &kp T                                             &kp Y      &kp U         &kp I       &kp O          &kp P    
&ctrl8 8 A      &kp S     &kp D     &kp F                &kp G                                             &kp H      &kp J         &kp K       &kp L          &mt RSFT MINUS
&mt LSFT Z      &kp X     &kp C     &kp V                &kp B                                             &kp N      &kp M         &kp COMMA   &kp DOT        &mo 3
                &kp LGUI  &kp LALT  &lt 2 INT_MUHENKAN   &lt1 1 SPACE   &mt LSFT INT_HENKAN        &kp RET  &kp BSPC                             &kp DEL
            >;
        };

        
        layer_1 {
            bindings = <
&kp CARET      &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp AT_SIGN                              &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES      &kp SEMI    &kp EXCLAMATION
&kp PLUS       &kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6   &kp HASH                                 &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp SINGLE_QUOTE       &kp COLON   &kp QMARK
&kp ASTERISK   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp UNDERSCORE                           &kp SLASH               &kp BACKSLASH          &kp AMPERSAND          &kp PIPE    &kp PERCENT
               &kp NUMBER_0   &kp DOT        &kp COMMA      &trans          &trans          &kp RET  &kp BSPC                                                              &kp DOLLAR
            >;
        };


        MOUSE {
            bindings = <
&trans   &kp F7   &kp F8   &kp F9   &kp F10                         &kp LC(Y)   &kp LC(C)        &kp LC(V)        &kp LC(X)         &kp LC(P)
&trans   &kp F4   &kp F5   &kp F6   &kp F11                         &kp LC(Z)   &mkp MB1         &kp UP_ARROW     &mkp MB2          &kp LC(F)
&trans   &kp F1   &kp F2   &kp F3   &kp F12                         &kp LC(A)   &kp LEFT_ARROW   &kp DOWN_ARROW   &kp RIGHT_ARROW   &kp HOME
         &trans   &trans   &trans   &trans    &trans      &kp RET   &kp BSPC                                      &kp ESC
            >;
        };


        SCROLL {
            bindings = <
&bt BT_CLR       &trans         &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans
&bt BT_CLR_ALL   &bt BT_SEL 4   &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans
&trans           &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans                                &trans   &trans   &trans   &trans   &trans
                 &bt BT_SEL 0   &trans         &trans         &trans   &trans      &studio_unlock   &trans                     &trans 
            >;
        };


        layer_4 {
            bindings = <
&trans   &trans         &trans         &trans         &trans                        &trans   &trans   &trans   &trans   &trans
&trans   &bt BT_SEL 4   &trans         &trans         &trans                        &trans   &trans   &trans   &trans   &trans
&trans   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans                        &trans   &trans   &trans   &trans   &trans
         &bt BT_SEL 0   &trans         &trans         &trans   &trans      &trans   &trans                     &trans
            >;
        };


        layer_5 {
            bindings = <
&trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans      
            >;
        };


        layer_6 {
            bindings = <
&trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans
            >;
        };

        // ころころKit: DYA Studioで任意のキーに MO 7〜10 を割り当てる。
        gesture_1 {
            display-name = "GESTURE1";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        gesture_2 {
            display-name = "GESTURE2";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        gesture_3 {
            display-name = "GESTURE3";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        gesture_4 {
            display-name = "GESTURE4";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

    };
};
